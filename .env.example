# Copiar a .env y completar. .env NO se versiona.

# Puerto 5433 porque 5432 suele estar ocupado.
# 127.0.0.1 y NO localhost: en Windows Node resuelve localhost a ::1 primero, y
# el puerto de Docker esta bound a IPv4, asi que 'localhost' falla con P1001.
DATABASE_URL="postgresql://nexa:nexa@127.0.0.1:5433/nexa"

# Generar con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotarlo invalida TODAS las sesiones activas de golpe.
SESSION_SECRET="cambiar-esto-por-48-bytes-aleatorios-en-base64url"

# Subir el entero invalida todas las cookies sin rotar el secreto.
# Es el mecanismo de "logout global" mientras no exista tabla Session.
SESSION_VERSION="1"

APP_ORIGIN="http://localhost:3000"
