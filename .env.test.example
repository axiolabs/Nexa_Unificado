# Entorno de TESTS. Separate del .env de desarrollo a proposito:
# los tests hacen TRUNCATE, y no tienen que tocar nunca datos de desarrollo.
#
#   npm run test:db:setup   (crea la base y aplica migraciones)
#   npm test                (levanta el server y corre la suite)
#
# CI genera este archivo en su propio paso; versionar un DATABASE_URL de test
# seria justo lo contrario de lo que se quiere.
DATABASE_URL="postgresql://nexa:nexa@127.0.0.1:5433/nexa_test"
SESSION_VERSION="1"
APP_ORIGIN="http://127.0.0.1:3100"
