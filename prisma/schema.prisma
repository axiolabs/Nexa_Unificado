generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  HOST
  MODERATOR
  CURATOR
  ADMIN
}

enum PlaceCategory {
  CAFE
  RESTAURANT
  MUSEUM
  PARK
  WORKSHOP
  SPORTS
  BAR
  LIBRARY
  OTHER
}

enum PlaceVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlanStatus {
  OPEN
  CANCELLED
  COMPLETED
}

enum ParticipantRole {
  ORGANIZER
  PARTICIPANT
}

enum ParticipationStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum ReportTarget {
  PLACE
  PLAN
  USER
  MESSAGE
}

enum ReportReason {
  CLOSED
  WRONG_INFO
  UNSAFE
  NO_SHOW_RISK
  MISLEADING
  HARASSMENT
  SPAM
  IMPERSONATION
  OFF_TOPIC
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  name            String
  avatarUrl       String?
  isActive        Boolean   @default(true)
  suspendedAt     DateTime?
  suspendedReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  roles              UserRoleAssignment[]
  accounts           AuthAccount[]
  ownedPlaces        Place[]
  createdPlans       Plan[]               @relation("PlanCreator")
  participations     PlanParticipant[]
  ratings            Rating[]
  personalityResults PersonalityResult[]
  deletedMessages    Message[]            @relation("MessageDeleter")
  reportsMade        ModerationReport[]   @relation("ReportReporter")
  reportsResolved    ModerationReport[]   @relation("ReportResolver")
  reportsAgainst     ModerationReport[]   @relation("ReportTargetUser")

  @@index([emailVerifiedAt])
}

model UserRoleAssignment {
  userId      String
  role        UserRole
  grantedAt   DateTime @default(now())
  grantedById String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model AuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Trait {
  id          String  @id @default(cuid())
  key         String  @unique
  label       String
  category    String
  description String?

  questions   PersonalityQuestion[]
  placeTraits PlaceTrait[]
  scores      PersonalityScore[]
}

model Place {
  id                 String                  @id @default(cuid())
  name               String
  description        String?
  category           PlaceCategory
  address            String?
  city               String?
  latitude           Decimal                 @db.Decimal(9, 6)
  longitude          Decimal                 @db.Decimal(9, 6)
  timezone           String
  verificationStatus PlaceVerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  ownerId            String?
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deletedAt          DateTime?

  owner  User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  traits PlaceTrait[]
  plans  Plan[]
  reports ModerationReport[]

  @@index([verificationStatus, category])
  @@index([city])
  @@index([latitude, longitude])
  @@index([ownerId])
}

model PlaceTrait {
  placeId String
  traitId String
  weight  Float

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  trait Trait @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@id([placeId, traitId])
  @@index([traitId])
}

model PersonalityTest {
  id          String    @id @default(cuid())
  version     Int       @unique
  name        String
  isActive    Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  questions PersonalityQuestion[]
  results   PersonalityResult[]
}

model PersonalityQuestion {
  id      String @id @default(cuid())
  testId  String
  prompt  String
  order   Int
  traitId String

  test    PersonalityTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  trait   Trait               @relation(fields: [traitId], references: [id], onDelete: Restrict)
  options PersonalityOption[]

  @@unique([testId, order])
  @@index([traitId])
}

model PersonalityOption {
  id         String @id @default(cuid())
  questionId String
  label      String
  scoreDelta Float
  order      Int

  question PersonalityQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  PersonalityAnswer[]

  @@unique([questionId, order])
}

model PersonalityResult {
  id          String   @id @default(cuid())
  userId      String
  testId      String
  completedAt DateTime @default(now())

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  test    PersonalityTest     @relation(fields: [testId], references: [id], onDelete: Restrict)
  answers PersonalityAnswer[]
  scores  PersonalityScore[]

  @@unique([userId, testId])
  @@index([userId, completedAt])
}

model PersonalityAnswer {
  id       String @id @default(cuid())
  resultId String
  optionId String

  result PersonalityResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  option PersonalityOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@unique([resultId, optionId])
}

model PersonalityScore {
  id       String @id @default(cuid())
  resultId String
  traitId  String
  value    Float

  result PersonalityResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  trait  Trait             @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([resultId, traitId])
  @@index([traitId])
}

model Plan {
  id            String     @id @default(cuid())
  title         String
  description   String?
  placeId       String
  creatorId     String
  startsAt      DateTime
  endsAt        DateTime?
  capacity      Int
  acceptedCount Int        @default(0)
  status        PlanStatus @default(OPEN)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  place        Place              @relation(fields: [placeId], references: [id], onDelete: Restrict)
  creator      User               @relation("PlanCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  participants PlanParticipant[]
  messages     Message[]
  ratings      Rating[]
  reports      ModerationReport[]

  @@index([placeId, startsAt])
  @@index([creatorId, createdAt])
  @@index([status, startsAt])
}

model PlanParticipant {
  planId         String
  userId         String
  role           ParticipantRole     @default(PARTICIPANT)
  status         ParticipationStatus @default(REQUESTED)
  joinedAt       DateTime            @default(now())
  respondedAt    DateTime?
  expiresAt      DateTime?
  reminderSentAt DateTime?

  plan     Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages Message[]
  ratings  Rating[]

  @@id([planId, userId])
  @@index([userId, status])
  @@index([planId, status])
  @@index([status, expiresAt])
}

model Message {
  id          String    @id @default(cuid())
  planId      String
  authorId    String
  body        String
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?
  deletedById String?

  plan          Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  participacion PlanParticipant    @relation(fields: [planId, authorId], references: [planId, userId], onDelete: Cascade)
  deletedBy     User?              @relation("MessageDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  reports       ModerationReport[]

  @@index([planId, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  planId    String
  authorId  String
  rating    Int
  /// Etiquetas cerradas de `lib/ratings.ts`, no texto libre. Un `String[]` de
  /// Postgres y no una tabla aparte: son ocho valores de un set que cambia con
  /// el producto, no una entidad con vida propia, y el `z.enum` del endpoint ya
  /// es la restriccion que las hace validas. Lo que **no** puede volver a
  /// aparecer es un `String?` de texto libre: §5.9 decide que `Rating` no
  /// contiene juicios sobre personas, y eso se sostiene en la forma de la tabla.
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan          Plan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  participacion PlanParticipant @relation(fields: [planId, authorId], references: [planId, userId], onDelete: Restrict)
  author        User            @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@unique([planId, authorId])
  @@index([planId])
  @@index([authorId])
}

/// Una denuncia. La cola de la curaduria, no un motor de castigo.
///
/// Esto REGISTRA un problema, no lo resuelve: no suspende a nadie, no cancela
/// planes ni saca lugares de circulacion. La accion la decide una persona del
/// equipo con las herramientas que ya existen (`Place.verificationStatus`,
/// `User.isActive`/`suspendedAt`, `PlanParticipant.status`), y esta tabla solo
/// le dice que hay algo para mirar.
///
/// Que sea una cola y no un automatismo no es una decision de arquitectura: es
/// §12 de `docs/decisiones-auth.md`, que ya decidio "intervencion humana, no
/// cancelacion automatica" porque un plan es una promesa con hora y lugar, y
/// sin canal de notificacion un cancel silencioso deja a gente que se presento
/// apuntando a algo que ya no existe.
///
/// Los cuatro `*Id` son nullable y hay EXACTAMENTE uno informado. No se usa un
/// `targetId` polimorfico suelto: eso no puede tener foreign key, o sea que la
/// base no impediria un reporte a un lugar que no existe. Con las columnas
/// separadas, `onDelete: SetNull` y el CHECK de la migracion, el reporte sobrevive
/// al borrado del objetivo (que es lo que tiene que pasar: el reporte es la
/// evidencia) pero nunca apunta a algo inexistente.
///
/// `target` esta aunque sea derivable de cual FK esta informado, por dos razones:
/// la cola agrupa por tipo sin un `CASE`, y los indices unicos parciales de la
/// migracion se apoyan en el.
model ModerationReport {
  id         String       @id @default(cuid())
  reporterId String
  target     ReportTarget
  reason     ReportReason
  /// Texto libre opcional, y opcional a proposito: forzar un comentario hace que
  /// la gente no denuncie ("no quiero escribir un texto"), y el motivo ya es un
  /// set cerrado que el endpoint valida.
  detail     String?

  status         ReportStatus @default(OPEN)
  /// Quien lo cerro y cuando. Es auditoria, no decoracion: sin esto no se puede
  /// saber si la cola se esta emptying o si nadie la esta tocando.
  resolvedById   String?
  resolvedAt     DateTime?
  /// Por que se cerro asi. Distingue "arreglamos esto" de "revisamos y esta
  /// bien": sin esa distincion no hay forma de saber cuantos reportes eran
  /// falsos, que es el numero que avisa si el producto esta generando ruido.
  resolutionNote String?

  placeId   String?
  planId    String?
  userId    String?
  messageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // `Restrict` y no `Cascade` en `reporterId`: borrar la cuenta de alguien se
  // lleva sus reportes, y un rastro de auditoria que se borra solo cuando borra
  // al denunciante no es un rastro de auditoria. Medido: 3 reportes -> 0.
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  // `resolvedById` si puede quedar en NULL: perder "quien cerro esto" es
  // tolerable, perder el reporte no.
  resolvedBy User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  // `Restrict` en las cuatro de objetivo, y no `SetNull`: `SET NULL` deja la
  // fila con cero objetivos informed y choca con el CHECK de "exactamente uno",
  // asi que borrar lo reportado fallaba. El borrado real de la app es el soft
  // delete por `deletedAt`; este `Restrict` es el freno del camino destructivo.
  place      Place?   @relation(fields: [placeId], references: [id], onDelete: Restrict)
  plan       Plan?    @relation(fields: [planId], references: [id], onDelete: Restrict)
  user       User?    @relation("ReportTargetUser", fields: [userId], references: [id], onDelete: Restrict)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([placeId])
  @@index([planId])
  @@index([userId])
  @@index([messageId])
  @@index([reporterId])
}
