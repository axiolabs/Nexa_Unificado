{
  "name": "nexa",
  "version": "0.1.0",
  "private": true,
  "description": "Nexa - planes con gente nueva. Servicio unico: Next.js App Router + API routes + Postgres.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "scan:nonlatin": "node scripts/scan-nonlatin.mjs",
    "check": "npm run scan:nonlatin && npm run typecheck",
    "postinstall": "prisma generate",
    "pretest": "npm run build",
    "test": "vitest run --config vitest.config.mts",
    "test:no-build": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:db:setup": "node scripts/create-test-db.mjs",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:logs": "docker compose logs -f db",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.mjs"
  },
  "keywords": [],
  "license": "ISC",
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^7.10.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "leaflet": "^1.9.4",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.5"
  }
}
